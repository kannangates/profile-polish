# ---- Shared free-tier key (optional) ----
# Used only when a student has NOT added their own key. Get a free key at
# https://aistudio.google.com/apikey. Never exposed to the browser.
GEMINI_API_KEY=
SHARED_MODEL=gemini-3.8-flash
# The shared key is a free demo. Set to false to end it (students then need
# their own key); the banner maker keeps its own switch. Redeploy after changing.
SHARED_KEY_ENABLED=true

# Fair-use limits for the shared key
SHARED_DAILY_LIMIT_PER_DEVICE=10
SHARED_DAILY_LIMIT_GLOBAL=200

# ---- LinkedIn banner maker (optional, PAID) ----
# Gemini has no free tier for image models, so this needs billing on
# GEMINI_API_KEY (~$0.034 per banner on the default model). Off unless "true".
BANNER_ENABLED=false
BANNER_MODEL=gemini-3.1-flash-lite-image
BANNER_DAILY_LIMIT_PER_DEVICE=2
BANNER_DAILY_LIMIT_GLOBAL=50

# ---- Upstash Redis (optional, free tier) ----
# Makes the limits above reliable across serverless instances. Without it,
# limits are in-memory per instance (fine for local dev / small pilots).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
